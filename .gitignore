node_modules/
.npm-cache/
.scratch/
dist/
*.log
.DS_Store
tests/browser/out/

# No PDF is ever part of this repository: the test corpus is a list of public
# URLs, downloaded into .scratch/pdfs. A stray download here is a mistake.
*.pdf
ext/key.pem

# Rust toolchain, cargo cache and emscripten SDK live in the workspace, not $HOME.
.rustup/
.cargo/
.emsdk/
core/target

# The core's wasm build: nine megabytes of binary and the minified Emscripten
# glue that loads it, written by `npm run build:wasm`. Neither is a source file -
# both are produced from `core/` - so neither belongs in the repository, the same
# way `dist/` does not.
demo/engine/
