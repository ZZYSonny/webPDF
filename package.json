{
  "name": "webpdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Render PDF pages to SVG with real, browser-renderable text",
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/webpdf.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config vite.demo.config.ts",
    "build": "npm run build:lib && npm run build:demo",
    "build:lib": "vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "build:pages": "npm run build:lib && npm run build:demo && node scripts/no-jekyll.mjs dist/demo",
    "build:extension": "vite build --config vite.ext.config.ts && node scripts/build-extension.mjs",
    "preview": "vite preview --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit",
    "pdfs": "node tests/pdf-cache.mjs",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node tests/browser/all.mjs",
    "verify": "npm run typecheck && npm test && npm run test:browser"
  },
  "dependencies": {
    "mupdf": "^1.28.1",
    "opentype.js": "^2.0.0",
    "text-vide": "^1.8.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/opentype.js": "^1.3.10",
    "fontkit": "^2.0.4",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}
